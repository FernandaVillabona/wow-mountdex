# Copia este archivo como .env.importer (en la raíz; git lo ignora).
# SOLO para la máquina que ejecuta el importador. Nunca en el frontend ni en Vercel.

# Supabase → Project Settings → API Keys → secret key (sb_secret_...) o service_role
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: renders oficiales del modelo (https://develop.battle.net/access/clients)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
