# Copia este archivo como frontend/.env (no se versiona).
# Todas estas variables son PÚBLICAS: acaban dentro del bundle del navegador.
# Nunca añadas aquí la service_role key de Supabase ni el client secret de Blizzard.

# Supabase → Project Settings → API
NG_SUPABASE_URL=
NG_SUPABASE_ANON_KEY=

# Blizzard → https://develop.battle.net/access/clients
NG_BLIZZARD_CLIENT_ID=
# Ej.: http://localhost:4200/blizzard/callback  o  https://tu-dominio.vercel.app/blizzard/callback
NG_BLIZZARD_REDIRECT_URI=
